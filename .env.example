# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# MongoDB
MONGODB_URI=
MONGODB_DATABASE=transit_buddy

# LLM (Developer 3 agent). Ollama app running and signed in: ":cloud" models run on Ollama's cloud.
LLM_PROVIDER=ollama
LLM_MODEL=glm-5.3-flash:cloud
# Optional: separate model for schedule screenshots (default: LLM_MODEL)
VISION_MODEL=
# Thinking effort: low keeps token use down (low | high | false)
LLM_REASONING=low
# Only to call ollama.com directly without the local app
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Trip planner (team's Never Late API, Google Maps behind it): real home -> class trip times for students who
# save a home address with /commute setup. Optional: without it, plans use a 30-minute estimate.
NEVER_LATE_TOKEN=
# NEVER_LATE_URL=https://never-late-api-966291054830.us-west1.run.app

# Application
APP_ENV=development
DEFAULT_TIMEZONE=America/Phoenix
# Minutes to arrive before class when planning around an inferred class start (default: 10).
COMMUTE_ARRIVAL_BUFFER_MINUTES=10
